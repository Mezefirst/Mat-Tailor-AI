# MatTailor AI Environment Configuration Template
# Copy this file to .env and update the values as needed

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# Server Configuration  
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://postgres:password@postgres:5432/mattailor
POSTGRES_DB=mattailor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# API Keys (Optional - services will work with limited functionality without them)
OPENAI_API_KEY=your-openai-key-here
HUGGINGFACE_API_KEY=your-hf-key-here
MATWEB_API_KEY=your-matweb-key-here
MATERIALS_PROJECT_API_KEY=your-mp-key-here

# Performance Settings
WORKER_THREADS=4
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=60

# Feature Flags
ENABLE_ML_PREDICTION=true
ENABLE_RL_PLANNING=true
ENABLE_NLP_PROCESSING=true
ENABLE_CACHING=true

# Logging
LOG_LEVEL=INFO

# Production Settings (for docker-compose.prod.yml)
BACKEND_URL=https://api.mattailor.com
FRONTEND_URL=https://mattailor.com
GRAFANA_PASSWORD=admin